{
  "name": "reachy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx ./src/server/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "worker": "node --conditions=react-server --import tsx ./src/server/jobs/worker.ts",
    "smoke:ingest": "node --conditions=react-server --import tsx ./scripts/smoke-ingest.ts",
    "smoke:brief": "node --conditions=react-server --import tsx ./scripts/smoke-brief.ts",
    "smoke:campaign": "node --conditions=react-server --import tsx ./scripts/smoke-campaign.ts",
    "smoke:image": "node --conditions=react-server --import tsx ./scripts/smoke-image.ts",
    "smoke:copy": "node --conditions=react-server --import tsx ./scripts/smoke-copy.ts",
    "smoke:reel": "node --conditions=react-server --import tsx ./scripts/smoke-reel.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/react": "^3.0.187",
    "@aws-sdk/client-s3": "^3.1044.0",
    "@aws-sdk/s3-request-presigner": "^3.1044.0",
    "@base-ui/react": "^1.4.1",
    "@better-auth/drizzle-adapter": "^1.6.9",
    "@e965/xlsx": "^0.20.3",
    "@elevenlabs/elevenlabs-js": "^2.47.0",
    "@fal-ai/client": "^1.10.1",
    "@types/fluent-ffmpeg": "^2.1.28",
    "adm-zip": "^0.5.17",
    "ai": "^6.0.185",
    "better-auth": "^1.6.9",
    "bullmq": "^5.76.6",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "fluent-ffmpeg": "^2.1.3",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.3",
    "next": "16.2.4",
    "next-intl": "^4.11.0",
    "next-themes": "^0.4.6",
    "openai": "^6.36.0",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.6.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}

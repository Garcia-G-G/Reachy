# =====================================================================
# Reachy — environment variables (template)
#
# Copy this file to `.env.local` and fill in real values.
# Source of truth: prompts/00-CONTEXT.md §0.7
# Never commit `.env.local` — only `.env.example` is checked in.
# =====================================================================

# --- Core ------------------------------------------------------------
# Local dev DB (matches docker/docker-compose.yml from Phase 01)
DATABASE_URL=postgres://reachy:reachy@localhost:5433/reachy
REDIS_URL=redis://localhost:6379

# better-auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-base64-secret
BETTER_AUTH_URL=http://localhost:3000

# Pin Next.js Server Actions encryption key so action ids stay stable across
# builds and across multiple instances (Vercel handles this automatically; for
# any self-hosted target — Fly, Render, ECS — set it explicitly). Generate
# with: openssl rand -base64 32
# https://nextjs.org/docs/app/guides/data-security
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- OAuth (Google) --------------------------------------------------
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI providers ----------------------------------------------------
OPENAI_API_KEY=
FAL_KEY=

# --- Storage (Cloudflare R2, S3-compatible) --------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=reachy-assets
R2_PUBLIC_URL=https://assets.reachy.app

# --- Email (Resend, for magic-link auth) -----------------------------
RESEND_API_KEY=
EMAIL_FROM=hello@reachy.app

#!/usr/bin/env bash
# Kamal sources this file at deploy time. Every variable resolved here
# becomes available to deploy.yml's `env.secret` list.
#
# Real values live in .env.production.local (gitignored). Sourcing it
# at the top means Garcia only edits ONE file when rotating secrets.
#
# Required env vars on first deploy:
#   KAMAL_REGISTRY_PASSWORD  — GitHub PAT with `write:packages`
#   BETTER_AUTH_SECRET        — openssl rand -base64 32
#   NEXT_SERVER_ACTIONS_ENCRYPTION_KEY — openssl rand -base64 32
#   POSTGRES_PASSWORD         — openssl rand -base64 24
#   OPENAI_API_KEY, FAL_KEY, RESEND_API_KEY
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_PUBLIC_URL
# Optional:
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET — leave empty to disable
#                                            Google OAuth (magic link still works)

set -e

if [ -f .env.production.local ]; then
  set -a
  # shellcheck disable=SC1091
  source .env.production.local
  set +a
fi

# Registry — pulled from $KAMAL_REGISTRY_PASSWORD in the local shell.
KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD:?set KAMAL_REGISTRY_PASSWORD (GitHub PAT with write:packages)}

# App-level secrets. The `?` syntax errors deploy if any are missing.
BETTER_AUTH_SECRET=${BETTER_AUTH_SECRET:?missing BETTER_AUTH_SECRET}
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=${NEXT_SERVER_ACTIONS_ENCRYPTION_KEY:?missing NEXT_SERVER_ACTIONS_ENCRYPTION_KEY}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:?missing POSTGRES_PASSWORD}
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID:-}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET:-}
OPENAI_API_KEY=${OPENAI_API_KEY:?missing OPENAI_API_KEY}
FAL_KEY=${FAL_KEY:?missing FAL_KEY}
RESEND_API_KEY=${RESEND_API_KEY:?missing RESEND_API_KEY}
R2_ACCOUNT_ID=${R2_ACCOUNT_ID:?missing R2_ACCOUNT_ID}
R2_ACCESS_KEY_ID=${R2_ACCESS_KEY_ID:?missing R2_ACCESS_KEY_ID}
R2_SECRET_ACCESS_KEY=${R2_SECRET_ACCESS_KEY:?missing R2_SECRET_ACCESS_KEY}
R2_PUBLIC_URL=${R2_PUBLIC_URL:?missing R2_PUBLIC_URL}

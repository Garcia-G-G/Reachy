# syntax=docker/dockerfile:1.7
# Reachy worker — BullMQ image/video worker.
#
# Runs tsx in production for runtime parity with `pnpm worker`. Includes
# FFmpeg + DejaVu fonts for the reel compositor (drawtext + concat).
# Image is ~700 MB because of ffmpeg + dev deps; that's the tradeoff for
# the simpler runtime (no separate build step, no dist/ to maintain).

FROM node:22-alpine
RUN apk add --no-cache libc6-compat ffmpeg fontconfig ttf-dejavu
WORKDIR /app

# Install ALL deps (tsx, dotenv, drizzle, sharp, etc. — devDeps included).
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile

# Source — no build step, tsx loads .ts files at runtime.
COPY . .

ENV NODE_ENV=production

# Non-root user — match the web runner's uid/gid for shared volumes.
RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 --ingroup nodejs reachy \
 && chown -R reachy:nodejs /app
USER reachy

# `--conditions=react-server` is required because the worker imports
# server-only modules (the same flag the dev `pnpm worker` script uses).
CMD ["node", "--conditions=react-server", "--enable-source-maps", "--import", "tsx", "src/server/jobs/worker.ts"]

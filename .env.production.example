# =====================================================================
# Reachy — PRODUCTION environment template
#
# This is the set of variables you paste into Dokploy → Environment.
# Keys marked [BUILD] are read at `pnpm build` time and must be present
# during the image build (in Dokploy, mark them as "build args" too).
# Everything else is read at runtime by web or worker.
#
# Never commit a filled-in copy of this file.
# =====================================================================

# --- Core (runtime) --------------------------------------------------
DATABASE_URL=postgres://reachy:CHANGE_ME@postgres:5432/reachy
REDIS_URL=redis://redis:6379

# better-auth — generate fresh with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://app.example.com

# Server Actions encryption key — keep stable across deploys so action IDs
# remain valid for in-flight clients. Generate once with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Postgres (compose only) -----------------------------------------
# Used by the `postgres` service in docker-compose.prod.yml. Must match
# the user/password in DATABASE_URL above.
POSTGRES_DB=reachy
POSTGRES_USER=reachy
POSTGRES_PASSWORD=

# --- OAuth (Google) --------------------------------------------------
# Authorized redirect URI: https://app.example.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI providers ----------------------------------------------------
OPENAI_API_KEY=
FAL_KEY=

# --- Storage (Cloudflare R2) ----------------------------------------- [BUILD]
# R2_PUBLIC_URL is read at build time to populate next.config remotePatterns
# + CSP img-src/connect-src. The rest are runtime only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=reachy-assets
R2_PUBLIC_URL=https://assets.example.com/

# --- Email (Resend, magic-link auth) ---------------------------------
RESEND_API_KEY=
EMAIL_FROM=hello@example.com

# --- Optional: observability -----------------------------------------
# Sentry — install @sentry/nextjs first, then uncomment.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Injected by your deploy pipeline; surfaces in /api/health.
GIT_SHA=

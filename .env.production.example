# =====================================================================
# Reachy — PRODUCTION environment template
#
# Copy this to `.env.production.local` (gitignored) and fill in real
# values. `.kamal/secrets` sources that file at deploy time, so every
# variable listed here under [SECRET] is automatically threaded into
# the container without ever touching the repo.
#
# Layout:
#   [SECRET]  — referenced by .kamal/secrets; never committed
#   [CLEAR]   — already set in config/deploy.yml's env.clear; only here
#               for reference / overrides
# =====================================================================

# ---------- Registry [SECRET] ----------------------------------------
# GitHub Personal Access Token with `write:packages` scope. Used by
# Kamal to push the locally-built image to ghcr.io/garcia-g-g/reachy.
KAMAL_REGISTRY_PASSWORD=

# ---------- App secrets [SECRET] -------------------------------------
# Generate fresh values BEFORE first deploy:
#   openssl rand -base64 32   → BETTER_AUTH_SECRET
#   openssl rand -base64 32   → NEXT_SERVER_ACTIONS_ENCRYPTION_KEY
#   openssl rand -base64 24   → POSTGRES_PASSWORD
BETTER_AUTH_SECRET=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# ---------- OAuth (optional) [SECRET] --------------------------------
# Leave empty to disable Google sign-in. Magic-link auth still works
# without these. Authorized redirect URI when you wire it up:
#   https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- AI providers [SECRET] ------------------------------------
OPENAI_API_KEY=
FAL_KEY=

# ---------- Email (Resend) [SECRET] ----------------------------------
RESEND_API_KEY=
# EMAIL_FROM is in deploy.yml under env.clear; defaults to
# onboarding@resend.dev. Override per-environment if you verify a
# domain on Resend.

# ---------- Cloudflare R2 [SECRET] -----------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://pub-<hex>.r2.dev
# R2_BUCKET is in deploy.yml under env.clear (default: reachy-assets).

# ---------- Optional: observability ----------------------------------
# Sentry — install @sentry/nextjs first, then add SENTRY_DSN +
# NEXT_PUBLIC_SENTRY_DSN to deploy.yml's env.secret and here.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# ---------- Convenience for non-secret overrides ---------------------
# These are NOT secrets; they live in config/deploy.yml's env.clear.
# Repeat them here only if you want to override per-environment.
# DATABASE_URL=postgres://reachy:$POSTGRES_PASSWORD@reachy-postgres:5432/reachy
# REDIS_URL=redis://reachy-redis:6379
# BETTER_AUTH_URL=https://<your-domain>
# R2_BUCKET=reachy-assets
# EMAIL_FROM=onboarding@resend.dev
